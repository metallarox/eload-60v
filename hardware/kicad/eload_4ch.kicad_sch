	(title_block
		(title "Carico attivo 60V 20A 300W — Indice")
		(date "2026-10-25")
		(rev "0.2")
		(company "IV3HGA")
		(comment 1 "Schema gerarchico: un foglio per blocco funzionale")
	)
	(lib_symbols)
	(text "Carico elettronico 4 canali - 60 V / 20 A / 300 W"
		(exclude_from_sim no)
		(at 30 185 0)
		(effects
			(font
				(size 1.524 1.524)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "0b0db7c1-99d6-472f-be96-cc72efde5485")
	)
	(text "Da verificare prima del layout"
		(exclude_from_sim no)
		(at 30 239.64 0)
		(effects
			(font
				(size 1.524 1.524)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "1c4aa346-5cca-491e-9159-eb645b70405a")
	)
	(text "Setpoint: DAC8565 0-2,5 V -> partitore 25:1 -> 0-100 mV su shunt 20 mOhm = 0-5 A. Il partitore e riferito al Kelvin freddo dello shunt (SHNx)."
		(exclude_from_sim no)
		(at 30 197.08 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "5a79a7da-e91e-4023-9342-234bfd83f399")
	)
	(text "INA228 in VSSOP-10 (passo 0,5 mm), DAC8565 in TSSOP-16, AP63205 in TSOT-23-6, induttore SRN4018, connettori THT."
		(exclude_from_sim no)
		(at 30 234.56 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "5f512b5c-cbc9-4521-b732-e760a6f0243e")
	)
	(text "ARM basso -> CLAMP alto -> i FET di clamp cortocircuitano VSET1..4 a massa. MCU in reset = carico spento."
		(exclude_from_sim no)
		(at 30 207.24 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "a75c392c-92bd-4f71-8f79-016792c1f9ce")
	)
	(text "Antenna del Wemos fuori dal bordo e lontana dal cooler (o antenna esterna su U.FL), stabilita del loop CC verificata in analisi (C 1n C0G / R 1k / Rg 100R, rev 0.2), da confermare al banco, I2t di D1 contro F1, FBSOA IXTH75N10L2 a 60 V e Tc 90 C."
		(exclude_from_sim no)
		(at 30 246.64 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "c197a5c9-29d6-45b8-8612-f8fd696dbef0")
	)
	(text "ARM (attivo alto, pull-down 10k) abilita il carico. LM393 (OVP 64,7 V, OTP ~100 C) e ALERT degli INA228 lo tirano basso in hardware."
		(exclude_from_sim no)
		(at 30 202.16 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "cbbc7082-f9fe-44c4-9e86-b525b311ae31")
	)
	(text "MOSFET di potenza TO-247 (montati sullo spreader), shunt WSK2512 Kelvin, diodo inversione D2PAK, TVS SMC/SMA,"
		(exclude_from_sim no)
		(at 30 229.48 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "d5b3160d-d78b-41df-b3b4-864cd2051996")
	)
	(text "Firmware ESP8266: dopo SPI.begin() riassegnare GPIO12 come uscita (ARM_DRV); GPIO16 = ARM_FB; A0 = NTC1 (partitore interno 220k/100k del D1 mini)."
		(exclude_from_sim no)
		(at 30 217.4 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "e32e8b60-0ffa-4927-b899-7fa6f0fb921b")
	)
	(text "GND unica = DUT- (stella sul prigioniero J2). Controllo solo via WiFi; USB del Wemos NON isolato: usarlo solo per programmare a DUT scollegato."
		(exclude_from_sim no)
		(at 30 212.32 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "e918996f-c269-4a49-884e-e5fb5bf48a07")
	)
	(text "Ogni canale: 0-5 A, max 75 W per MOSFET. Sopra 15 V il limite e la potenza (300 W / V), gestito da firmware + ALERT INA228."
		(exclude_from_sim no)
		(at 30 192 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "f8891002-7a58-4e84-b9d3-6e565ed20a3c")
	)
	(text "Eccezioni alla regola SMD SOIC/SOP + passivi 1206"
		(exclude_from_sim no)
		(at 30 222.48 0)
		(effects
			(font
				(size 1.524 1.524)
				(bold yes)
			)
