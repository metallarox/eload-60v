	(title_block
		(title "Electronic Load 4ch 60V 20A 300W — Index")
		(date "2026-10-25")
		(rev "0.3")
		(company "IV3HGA")
		(comment 1 "Hierarchical schematic: one sheet per functional block")
	)
	(lib_symbols)
	(text "Exceptions to the SMD SOIC/SOP + 1206 passives rule"
		(exclude_from_sim no)
		(at 30 227.56 0)
		(effects
			(font
				(size 1.524 1.524)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "020ed0d2-7ac4-417e-a41e-c689c7e67e1c")
	)
	(text "INA228 in VSSOP-10 (0.5 mm pitch), DAC8565 in TSSOP-16, AP63205 in TSOT-23-6, SRN4018 inductor, THT connectors."
		(exclude_from_sim no)
		(at 30 239.64 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "04bd6161-bb82-4a39-bbc7-2b24b3842536")
	)
	(text "4-channel electronic load - 60 V / 20 A / 300 W"
		(exclude_from_sim no)
		(at 30 185 0)
		(effects
			(font
				(size 1.524 1.524)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "255b3af1-429c-4aac-a135-6496eceece9c")
	)
	(text "Setpoint: DAC8565 0-2.5 V -> 25:1 divider -> 0-100 mV on 20 mOhm shunt = 0-5 A. The divider is referenced to the cold Kelvin pad of the shunt (SHNx)."
		(exclude_from_sim no)
		(at 30 197.08 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "361dd590-7daa-44e5-94d8-730ddec26f0f")
	)
	(text "Wemos antenna off the board edge and away from the cooler (or external antenna on U.FL); CC loop stability analysed (C 1n C0G / R 1k / Rg 100R, rev 0.2), to confirm on the bench; D1 I2t vs F1; IXTH75N10L2 FBSOA at 60 V and Tc 90 C."
		(exclude_from_sim no)
		(at 30 251.72 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "43d229eb-5932-4ac7-afe3-e8e7c9d81b48")
	)
	(text "ARM (active high, 10k pull-down) enables the load. LM393 (OVP 64.7 V, OTP ~100 C) and the INA228 ALERTs pull it low in hardware."
		(exclude_from_sim no)
		(at 30 202.16 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "4542240b-3cac-4d37-8662-c30ccea608e8")
	)
	(text "Each channel: 0-5 A, max 75 W per MOSFET. Above 15 V the limit is power (300 W / V), enforced by firmware + INA228 ALERT."
		(exclude_from_sim no)
		(at 30 192 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "506763cc-0db0-4913-80b2-89a8fb5f6300")
	)
	(text "ARM low -> CLAMP high -> clamp FETs short VSET1..4 to ground. MCU in reset = load off."
		(exclude_from_sim no)
		(at 30 207.24 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "53560d1b-9e71-44df-810e-2cf417b549ca")
	)
	(text "ESP8266 firmware: after SPI.begin() re-assign GPIO12 as output (ARM_DRV); GPIO16 = ARM_FB; A0 = NTC1 (D1 mini internal 220k/100k divider)."
		(exclude_from_sim no)
		(at 30 217.4 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "6d373833-a872-475f-bc83-abf325765881")
	)
	(text "Front panel (rev 0.3): PCF8574 @0x20 (encoder A/B/SW, OUTPUT button, LED), INT on GPIO0; OLED @0x3C on the same bus. OUTPUT ON enables ARM, never automatic."
		(exclude_from_sim no)
		(at 30 222.48 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "869048e0-f9f4-47b6-acc6-dcfc35c84946")
	)
	(text "To verify on the bench"
		(exclude_from_sim no)
		(at 30 244.72 0)
		(effects
			(font
				(size 1.524 1.524)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "8c22f97c-4303-471e-a235-211a955c361d")
	)
	(text "TO-247 power MOSFETs (mounted on the spreader), WSK2512 Kelvin shunts, D2PAK reverse-polarity diode, SMC/SMA TVS,"
		(exclude_from_sim no)
		(at 30 234.56 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "b08f6b60-e977-4ba0-b183-5104663a919f")
	)
	(text "Single GND = DUT- (star point at stud J2). Control over WiFi only; the Wemos USB is NOT isolated: use it only for programming with the DUT disconnected."
		(exclude_from_sim no)
		(at 30 212.32 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
